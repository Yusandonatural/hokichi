# 出力物には候補地の地番が入る。個人情報に近づくため追跡しない。
out/

# eMAFF農地ナビからダウンロードした実データ。公表情報なので置いてよいが、
# 容量が大きくなるので Git LFS か手元管理を推奨。サンプルは追跡する。
data/*.csv
data/column_map.json
data/fude/
!data/sample/*.csv

# ビルド生成物（GitHub Actions が作る）。サンプル由来のものだけ追跡しない
web/data/

# 登記・調査の実データを置く場所（絶対にコミットしない）
private/
*.pdf

__pycache__/
*.pyc
.DS_Store
node_modules/
.wrangler/
.dev.vars
